{
  "name": "dj-felicitous",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "check:env": "tsx scripts/check-env.ts",
    "db:generate": "pnpm --filter @dj/db generate",
    "db:migrate": "pnpm --filter @dj/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @dj/db migrate:deploy",
    "db:migrate:check": "pnpm --filter @dj/db migrate:check",
    "db:seed": "pnpm --filter @dj/db seed",
    "db:studio": "pnpm --filter @dj/db studio",
    "db:reset": "pnpm --filter @dj/db reset",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
