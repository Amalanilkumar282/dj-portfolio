{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./packages/ui/src/styles/theme.css",
  "overrides": [
    { "files": "*.prisma", "options": { "tabWidth": 2 } },
    { "files": "*.md", "options": { "printWidth": 100, "proseWrap": "preserve" } }
  ]
}
