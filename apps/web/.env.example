# apps/web — see docs/05-operations/env-vars.md

# Canonical origin. A wrong value breaks every canonical URL, OG image and
# sitemap entry.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only. The public browser never calls the API directly — that
# keeps the key server-side, avoids CORS and keeps the origin cacheable.
API_INTERNAL_URL=http://localhost:4000/api/v1
API_KEY=replace-me-with-32-bytes-of-base64-randomness-abc

# These MUST match apps/api exactly. A REVALIDATE_SECRET mismatch means
# published content silently stops appearing.
REVALIDATE_SECRET=replace-me-with-32-bytes-of-base64-randomness
PREVIEW_TOKEN=replace-me-with-32-bytes-of-base64-randomness-xyz

# Public by design — appears in every image URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-me
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-me

# Analytics (Phase 8)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=djfelicitous.com
# NEXT_PUBLIC_GA_ID=
