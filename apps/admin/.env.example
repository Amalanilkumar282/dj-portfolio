# apps/admin — see docs/05-operations/env-vars.md

NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Admin DOES call the API from the browser, for optimistic updates.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Server-side, for route guards.
API_INTERNAL_URL=http://localhost:4000/api/v1
API_KEY=replace-me-with-32-bytes-of-base64-randomness-abc

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_UPLOAD_PRESET=djf-signed
