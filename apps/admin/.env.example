# apps/admin — see docs/05-operations/env-vars.md

NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Admin DOES call the API from the browser, for optimistic updates.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Server-side, for route guards.
API_INTERNAL_URL=http://localhost:4000/api/v1
API_KEY=replace-me-with-32-bytes-of-base64-randomness-abc

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_UPLOAD_PRESET=djf-signed

# The public site's own URL, and the SAME value as apps/web's PREVIEW_TOKEN
# (not NEXT_PUBLIC_ there — it's server-only in web, but the admin needs it
# client-side to build a "View live site" / "Preview" link, so it is
# NEXT_PUBLIC_ here instead). This is a deliberate, documented tradeoff, not
# an oversight: the token is a shared secret between apps/web's /api/draft
# route and whoever is allowed to construct these links — admin users, who
# are already authenticated to reach this page in the first place. See
# apps/admin/src/lib/preview.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PREVIEW_TOKEN=replace-me-with-32-bytes-of-base64-randomness-xyz
