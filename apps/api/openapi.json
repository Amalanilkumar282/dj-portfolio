{
  "components": {
    "schemas": {
      "ChangePasswordDto": {
        "properties": {
          "currentPassword": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "newPassword": {
            "maxLength": 256,
            "minLength": 12,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 320,
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "totp": {
            "maxLength": 16,
            "minLength": 6,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "PersonaCreateDto": {
        "properties": {
          "accentColor": {
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "type": "string"
          },
          "accentColorSecondary": {
            "nullable": true,
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "type": "string"
          },
          "bio": {
            "minLength": 1,
            "type": "string"
          },
          "bioShort": {
            "nullable": true,
            "type": "string"
          },
          "bpmRangeHigh": {
            "exclusiveMaximum": false,
            "exclusiveMinimum": false,
            "maximum": 300,
            "minimum": 60,
            "nullable": true,
            "type": "integer"
          },
          "bpmRangeLow": {
            "exclusiveMaximum": false,
            "exclusiveMinimum": false,
            "maximum": 300,
            "minimum": 60,
            "nullable": true,
            "type": "integer"
          },
          "country": {
            "maxLength": 120,
            "nullable": true,
            "type": "string"
          },
          "genreSlugs": {
            "items": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "maxItems": 30,
            "type": "array"
          },
          "gradientCss": {
            "maxLength": 500,
            "nullable": true,
            "type": "string"
          },
          "homeCity": {
            "maxLength": 120,
            "nullable": true,
            "type": "string"
          },
          "isDuo": {
            "type": "boolean"
          },
          "isFeatured": {
            "type": "boolean"
          },
          "key": {
            "enum": [
              "FELICITOUS",
              "TRINITROCOSMIC",
              "TNT",
              "COUPLE_DUO"
            ],
            "type": "string"
          },
          "memberNames": {
            "items": {
              "maxLength": 120,
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "primaryGenreLabel": {
            "maxLength": 80,
            "nullable": true,
            "type": "string"
          },
          "scheduledAt": {
            "nullable": true
          },
          "shortDescription": {
            "maxLength": 280,
            "nullable": true,
            "type": "string"
          },
          "slug": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "sortIndex": {
            "exclusiveMinimum": false,
            "minimum": 0,
            "type": "integer"
          },
          "stageName": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "ARCHIVED"
            ],
            "type": "string"
          },
          "subtitle": {
            "maxLength": 160,
            "nullable": true,
            "type": "string"
          },
          "tagline": {
            "maxLength": 200,
            "nullable": true,
            "type": "string"
          },
          "yearsActiveFrom": {
            "exclusiveMaximum": false,
            "exclusiveMinimum": false,
            "maximum": 2100,
            "minimum": 1990,
            "nullable": true,
            "type": "integer"
          }
        },
        "required": [
          "key",
          "stageName",
          "bio"
        ],
        "type": "object"
      },
      "PersonaUpdateDto": {
        "properties": {
          "accentColor": {
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "type": "string"
          },
          "accentColorSecondary": {
            "nullable": true,
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "type": "string"
          },
          "bio": {
            "minLength": 1,
            "type": "string"
          },
          "bioShort": {
            "nullable": true,
            "type": "string"
          },
          "bpmRangeHigh": {
            "exclusiveMaximum": false,
            "exclusiveMinimum": false,
            "maximum": 300,
            "minimum": 60,
            "nullable": true,
            "type": "integer"
          },
          "bpmRangeLow": {
            "exclusiveMaximum": false,
            "exclusiveMinimum": false,
            "maximum": 300,
            "minimum": 60,
            "nullable": true,
            "type": "integer"
          },
          "country": {
            "maxLength": 120,
            "nullable": true,
            "type": "string"
          },
          "genreSlugs": {
            "items": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "maxItems": 30,
            "type": "array"
          },
          "gradientCss": {
            "maxLength": 500,
            "nullable": true,
            "type": "string"
          },
          "homeCity": {
            "maxLength": 120,
            "nullable": true,
            "type": "string"
          },
          "isDuo": {
            "type": "boolean"
          },
          "isFeatured": {
            "type": "boolean"
          },
          "key": {
            "enum": [
              "FELICITOUS",
              "TRINITROCOSMIC",
              "TNT",
              "COUPLE_DUO"
            ],
            "type": "string"
          },
          "memberNames": {
            "items": {
              "maxLength": 120,
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "primaryGenreLabel": {
            "maxLength": 80,
            "nullable": true,
            "type": "string"
          },
          "scheduledAt": {
            "nullable": true
          },
          "shortDescription": {
            "maxLength": 280,
            "nullable": true,
            "type": "string"
          },
          "slug": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "sortIndex": {
            "exclusiveMinimum": false,
            "minimum": 0,
            "type": "integer"
          },
          "stageName": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "ARCHIVED"
            ],
            "type": "string"
          },
          "subtitle": {
            "maxLength": 160,
            "nullable": true,
            "type": "string"
          },
          "tagline": {
            "maxLength": 200,
            "nullable": true,
            "type": "string"
          },
          "yearsActiveFrom": {
            "exclusiveMaximum": false,
            "exclusiveMinimum": false,
            "maximum": 2100,
            "minimum": 1990,
            "nullable": true,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ReorderDto": {
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "id": {
                  "pattern": "^[a-z0-9]{20,32}$",
                  "type": "string"
                },
                "sortIndex": {
                  "exclusiveMinimum": false,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "sortIndex"
              ],
              "type": "object"
            },
            "maxItems": 500,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "type": "object"
      },
      "ScheduleDto": {
        "properties": {
          "publishAt": {}
        },
        "required": [
          "publishAt"
        ],
        "type": "object"
      },
      "TotpDisableDto": {
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "TotpVerifyDto": {
        "properties": {
          "totp": {
            "pattern": "^\\d{6}$",
            "type": "string"
          }
        },
        "required": [
          "totp"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "cookie": {
        "in": "cookie",
        "name": "dj_rt",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Content and booking API. Public reads are by slug and cacheable; admin writes are by id and require a bearer token. Errors follow RFC 9457 (application/problem+json).",
    "title": "DJ Felicitous API",
    "version": "1"
  },
