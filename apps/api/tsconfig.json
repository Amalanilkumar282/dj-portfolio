{
  // The editor, lint and typecheck config: everything that is source,
  // including the test suites. `tsconfig.build.json` narrows this to `src`
  // for the actual build — see the note there.
  //
  // typescript-eslint runs with `projectService`, which resolves each file
  // against the nearest tsconfig. A file matched by no `include` is a parsing
  // error rather than an unchecked file, so the e2e specs must be listed here
  // or they lint as "not found by the project service".
  "extends": "@dj/config-ts/nest.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
