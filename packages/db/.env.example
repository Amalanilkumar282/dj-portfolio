# @dj/db - used only by the Prisma CLI (migrate, studio, seed).
# The API reads these from apps/api/.env.local at runtime.

# Pooled connection (Neon -pooler / PgBouncer endpoint) used at runtime.
# `pgbouncer=true` makes Prisma skip prepared statements, which
# transaction-mode pooling cannot support. See docs/05-operations/env-vars.md
DATABASE_URL="postgresql://djf:djf@localhost:5432/djf?schema=public"

# Unpooled connection. Migrations and DDL need a session (advisory locks),
# so this must NOT point at the pooler.
DIRECT_URL="postgresql://djf:djf@localhost:5432/djf?schema=public"

# Only needed by `pnpm db:migrate:check` in CI.
SHADOW_DATABASE_URL="postgresql://djf:djf@localhost:5432/djf_shadow?schema=public"

# --- seeding -----------------------------------------------------------
# `seed:admin` refuses to run in production if a SUPER_ADMIN already exists.
ADMIN_SEED_EMAIL="admin@djfelicitous.com"
ADMIN_SEED_PASSWORD="ChangeMe!12345"

# Cloudinary namespace the content seed uploads legacy images into.
CLOUDINARY_ROOT_FOLDER="djf-dev"
