// ============================================================================
//  DJ Felicitous - data model
//  See docs/02-architecture/data-model.md for the rationale behind each field.
//
//  Conventions applied to every content model:
//    - cuid(2) ids, snake_case table names via @@map
//    - soft delete via deletedAt, enforced by a Prisma client extension
//      (packages/db/src/extensions/soft-delete.ts) so `delete` never issues
//      a real SQL DELETE
//    - audit fields createdAt/updatedAt/createdBy/updatedBy, populated from
//      the request context (packages/db/src/extensions/audit.ts)
//    - publish workflow: status + publishedAt + scheduledAt
//    - slug unique, sortIndex for manual ordering
//    - optional 1:1 SeoMeta relation (Postgres has no embeddables; a shared
//      table beats duplicating 8 columns across 12 models and lets the admin
//      SEO editor be one reusable component)
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "nativeDistinct", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL") // pooled (pgbouncer) - runtime
  directUrl  = env("DIRECT_URL") // unpooled - migrations, DDL, advisory locks
  // pg_trgm backs the trigram GIN indexes declared on title/name columns.
  // Declaring it here keeps CREATE EXTENSION inside a Prisma migration, so
  // `migrate:check` can verify it rather than treating it as drift.
  extensions = [pg_trgm]
}

// ============================================================================
//  ENUMS
// ============================================================================

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Stable programmatic handles for the four acts. Slugs may change for SEO;
/// these never do, so code and seeds can reference a persona safely.
enum PersonaKey {
  FELICITOUS
  TRINITROCOSMIC
  TNT
  COUPLE_DUO
}

enum TrackType {
  ORIGINAL
  REMIX
  LIVE_SET
  MIX
  PODCAST
  COLLABORATION
}

enum ReleaseType {
  ALBUM
  EP
  SINGLE
  COMPILATION
}

enum EventKind {
  CLUB
  FESTIVAL
  WEDDING
  CORPORATE
  PRIVATE
  RADIO
  LIVESTREAM
}

enum EventStatus {
  ANNOUNCED
  CONFIRMED
  SOLD_OUT
  CANCELLED
  POSTPONED
  COMPLETED
}

enum MediaResourceType {
  IMAGE
  VIDEO
  AUDIO
  RAW
}

enum MediaPurpose {
  HERO
  GALLERY
  AVATAR
  FLYER
  COVER_ART
  LOGO
  PRESS_PHOTO
  DOCUMENT
  BACKGROUND_VIDEO
  OG_IMAGE
  GEAR
