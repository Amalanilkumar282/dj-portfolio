  UPDATE
  DELETE
  RESTORE
  PUBLISH
  UNPUBLISH
  ARCHIVE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGE
  TOKEN_REFRESH
  TOKEN_REUSE_DETECTED
  ROLE_CHANGE
  TWO_FA_ENABLE
  TWO_FA_DISABLE
  MEDIA_UPLOAD
  MEDIA_DELETE
  SETTINGS_UPDATE
  MAIL_FAILED
