{
  "name": "@dj/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "default": "./dist/extensions/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev && pnpm post-migrate",
    "migrate:deploy": "prisma migrate deploy && pnpm post-migrate",
    "migrate:check": "prisma migrate diff --from-migrations ./prisma/migrations --to-schema-datamodel ./prisma/schema.prisma --shadow-database-url $SHADOW_DATABASE_URL --exit-code",
    "validate": "prisma validate",
    "format": "prisma format",
    "studio": "prisma studio",
    "seed": "tsx seed/index.ts",
    "seed:system": "tsx seed/index.ts --only=system",
    "seed:content": "tsx seed/index.ts --only=content",
    "seed:demo": "tsx seed/index.ts --only=demo",
    "reset": "prisma migrate reset --force --skip-seed && pnpm post-migrate && pnpm seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "post-migrate": "tsx scripts/post-migrate.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@dj/utils": "workspace:*",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@dj/config-eslint": "workspace:*",
    "@dj/config-ts": "workspace:*",
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist"
  ]
}
