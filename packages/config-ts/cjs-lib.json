{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "CommonJS Library",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "incremental": false,
    "noEmit": false,
    "verbatimModuleSyntax": false
  }
}
